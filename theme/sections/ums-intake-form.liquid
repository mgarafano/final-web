{%- comment -%}
  Intake form — UMS for Organizations (brief §5.5).

  Built on Shopify's native contact form: posts to /contact, and Shopify
  emails every field to the store's contact address. No app, no serverless
  piece. Custom fields ride along as contact[Label] and arrive in the email
  labelled exactly as written here.

  After a successful post Shopify returns to this page with
  ?contact_posted=true. The whole form is replaced with a confirmation
  screen — a distinct state, not an inline message. No email goes to the
  customer, by decision.

  If the customer used Build your list, the list is read from sessionStorage
  and prefilled into the "Exact products chosen" field and shown read-only
  above it.

  No pricing, no turnaround promises anywhere on this page.
{%- endcomment -%}

<div class="ums-intake page-width">
  {%- form 'contact', id: 'UmsIntake', class: 'ums-intake__form' -%}

    {%- if form.posted_successfully? -%}
      <div class="ums-intake__done" role="status" tabindex="-1" id="UmsIntakeDone">
        <p class="ums-intake__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h1 class="ums-intake__title">{{ section.settings.done_heading | escape }}</h1>
        <div class="ums-intake__body rte">{{ section.settings.done_body }}</div>
        <div class="ums-intake__done-actions">
          <a class="button" href="{{ section.settings.done_link }}">{{ section.settings.done_link_label | escape }}</a>
        </div>
      </div>
      <script>
        try { sessionStorage.removeItem('ums:orgList'); } catch (e) {}
        var d = document.getElementById('UmsIntakeDone'); if (d) { d.focus(); window.scrollTo(0, 0); }
      </script>

    {%- else -%}

      <div class="ums-intake__intro">
        <p class="ums-intake__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h1 class="ums-intake__title">{{ section.settings.heading | escape }}</h1>
        {%- if section.settings.body != blank -%}
          <div class="ums-intake__body rte">{{ section.settings.body }}</div>
        {%- endif -%}
      </div>

      {%- if form.errors -%}
        <div class="ums-intake__errors" role="alert">
          <p><strong>{{ 'templates.contact.form.error_heading' | t }}</strong></p>
          <ul>
            {%- for field in form.errors -%}
              <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <p class="ums-intake__required-note">{{ section.settings.required_note | escape }}</p>

      {%- comment -%} ---- Who you are ---- {%- endcomment -%}
      <fieldset class="ums-intake__group">
        <legend class="ums-intake__legend">About you</legend>

        <div class="field">
          <input class="field__input" id="UmsOrg" type="text" name="contact[Organization]" required autocomplete="organization" placeholder=" ">
          <label class="field__label" for="UmsOrg">Organization name <span aria-hidden="true">*</span></label>
        </div>

        <div class="ums-intake__two">
          <div class="field">
            <input class="field__input" id="UmsName" type="text" name="contact[Name]" required autocomplete="name" placeholder=" ">
            <label class="field__label" for="UmsName">Your name <span aria-hidden="true">*</span></label>
          </div>
          <div class="field">
            <input class="field__input" id="UmsEmail" type="email" name="contact[email]" required autocomplete="email" placeholder=" " spellcheck="false" autocapitalize="off">
            <label class="field__label" for="UmsEmail">Email <span aria-hidden="true">*</span></label>
          </div>
        </div>

        <div class="field">
          <input class="field__input" id="UmsPhone" type="tel" name="contact[Phone]" autocomplete="tel" placeholder=" ">
          <label class="field__label" for="UmsPhone">Phone (optional)</label>
        </div>
      </fieldset>

      {%- comment -%} ---- What you need ---- {%- endcomment -%}
      <fieldset class="ums-intake__group" id="UmsTypes">
        <legend class="ums-intake__legend">What you need <span aria-hidden="true">*</span></legend>
        <p class="ums-intake__hint">Choose every kind of order that applies.</p>
        <div class="ums-intake__checks">
          {%- assign types = section.settings.product_types | newline_to_br | split: '<br />' -%}
          {%- for t in types -%}
            {%- assign clean = t | strip_newlines | strip -%}
            {%- if clean != blank -%}
              <label class="ums-intake__check">
                <input type="checkbox" name="contact[Product types]" value="{{ clean | escape }}">
                <span>{{ clean | escape }}</span>
              </label>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <p class="ums-intake__field-error" id="UmsTypesError" hidden>Choose at least one.</p>
      </fieldset>

      <fieldset class="ums-intake__group">
        <legend class="ums-intake__legend">Your order</legend>

        <div class="field">
          <input class="field__input" id="UmsQty" type="number" min="1" step="1" inputmode="numeric" name="contact[Estimated quantity]" required placeholder=" ">
          <label class="field__label" for="UmsQty">Estimated total quantity <span aria-hidden="true">*</span></label>
        </div>

        <div class="ums-intake__list" id="UmsListPanel" hidden>
          <p class="ums-intake__list-head">Your list from the previous step</p>
          <ul class="ums-intake__list-items" id="UmsListItems"></ul>
          <p class="ums-intake__list-edit">
            <a href="{{ section.settings.build_list_url }}">Edit the list</a>
          </p>
        </div>

        <div class="field">
          <textarea class="text-area field__input" id="UmsExact" name="contact[Exact products chosen]" rows="4" placeholder=" "></textarea>
          <label class="field__label" for="UmsExact">Exact products, if you already know</label>
        </div>

        <div class="ums-intake__two">
          <div class="field">
            <select class="select__select field__input" id="UmsMethod" name="contact[Preferred decoration method]">
              <option value="">Preferred decoration (optional)</option>
              {%- assign methods = section.settings.decoration_methods | newline_to_br | split: '<br />' -%}
              {%- for m in methods -%}
                {%- assign clean = m | strip_newlines | strip -%}
                {%- if clean != blank -%}<option value="{{ clean | escape }}">{{ clean | escape }}</option>{%- endif -%}
              {%- endfor -%}
            </select>
          </div>
          <div class="field">
            <input class="field__input" id="UmsDate" type="date" name="contact[Event or deadline date]" placeholder=" ">
            <label class="field__label" for="UmsDate">Event or deadline date (optional)</label>
          </div>
        </div>

        <div class="field">
          <input class="field__input" id="UmsBudget" type="text" name="contact[Estimated budget]" inputmode="decimal" placeholder=" ">
          <label class="field__label" for="UmsBudget">Estimated budget (optional)</label>
        </div>

        {%- comment -%}
          Artwork upload slot. Shopify's native contact form cannot accept
          file attachments, so this is wired up by the upload app once it is
          installed. Until then the customer is told to email artwork.
        {%- endcomment -%}
        <div class="ums-intake__artwork" id="UmsArtworkSlot">
          <p class="ums-intake__list-head">Artwork (optional)</p>
          <p class="ums-intake__hint">{{ section.settings.artwork_note | escape }}</p>
        </div>
      </fieldset>

      <fieldset class="ums-intake__group">
        <legend class="ums-intake__legend">One last thing</legend>
        <div class="field">
          <select class="select__select field__input" id="UmsHeard" name="contact[How did you hear about us]">
            <option value="">How did you hear about us? (optional)</option>
            {%- assign heard = section.settings.heard_options | newline_to_br | split: '<br />' -%}
            {%- for h in heard -%}
              {%- assign clean = h | strip_newlines | strip -%}
              {%- if clean != blank -%}<option value="{{ clean | escape }}">{{ clean | escape }}</option>{%- endif -%}
            {%- endfor -%}
          </select>
        </div>
        <div class="field">
          <textarea class="text-area field__input" id="UmsNotes" name="contact[Notes]" rows="4" placeholder=" "></textarea>
          <label class="field__label" for="UmsNotes">Anything else we should know? (optional)</label>
        </div>
      </fieldset>

      <input type="hidden" name="contact[Source]" value="UMS for Organizations intake form">

      <div class="ums-intake__submit">
        <button type="submit" class="button">{{ section.settings.submit_label | escape }}</button>
        <p class="ums-intake__submit-note">{{ section.settings.submit_note | escape }}</p>
      </div>

      <script>
        (function () {
          // Prefill from Build your list.
          var panel = document.getElementById('UmsListPanel');
          var items = document.getElementById('UmsListItems');
          var exact = document.getElementById('UmsExact');
          var qty = document.getElementById('UmsQty');
          var lines = [];
          try { lines = JSON.parse(sessionStorage.getItem('ums:orgList') || '[]'); } catch (e) { lines = []; }
          if (Array.isArray(lines) && lines.length) {
            var total = 0;
            var text = lines.map(function (l) {
              total += (parseInt(l.qty, 10) || 0);
              var li = document.createElement('li');
              li.textContent = l.qty + ' × ' + l.item;
              items.appendChild(li);
              return l.qty + ' x ' + l.item;
            }).join('\n');
            panel.hidden = false;
            if (exact && !exact.value) exact.value = text;
            if (qty && !qty.value && total > 0) qty.value = total;
          }

          // At least one product type — HTML can't require a checkbox group.
          var form = document.getElementById('UmsIntake');
          var group = document.getElementById('UmsTypes');
          var err = document.getElementById('UmsTypesError');
          form.addEventListener('submit', function (e) {
            var any = group.querySelector('input[type="checkbox"]:checked');
            if (!any) {
              e.preventDefault();
              err.hidden = false;
              group.classList.add('is-invalid');
              group.scrollIntoView({ block: 'center' });
              var first = group.querySelector('input[type="checkbox"]');
              if (first) first.focus();
            }
          });
          group.addEventListener('change', function () {
            if (group.querySelector('input[type="checkbox"]:checked')) {
              err.hidden = true;
              group.classList.remove('is-invalid');
            }
          });
        })();
      </script>

    {%- endif -%}
  {%- endform -%}
</div>

{% stylesheet %}
  .ums-intake { padding-block: 4rem 6rem; max-width: 72rem; }
  .ums-intake__eyebrow {
    margin: 0 0 1.2rem; font-size: 1.2rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.7;
  }
  .ums-intake__title { margin: 0; font-size: clamp(2.8rem, 5vw, 4rem); line-height: 1.08; letter-spacing: -0.02em; }
  .ums-intake__body { margin-top: 1.6rem; max-width: 60ch; font-size: 1.7rem; }
  .ums-intake__body > :first-child { margin-top: 0; }
  .ums-intake__body > :last-child { margin-bottom: 0; }

  .ums-intake__required-note { margin: 2.4rem 0 0; font-size: 1.3rem; opacity: 0.7; }

  .ums-intake__errors {
    margin-top: 2.4rem; padding: 1.4rem 1.8rem;
    background: rgba(200, 60, 30, 0.08); border-left: 3px solid #9c4a2f;
  }
  .ums-intake__errors p { margin: 0; }
  .ums-intake__errors ul { margin: 0.6rem 0 0; padding-left: 1.8rem; }

  .ums-intake__group {
    border: 0; padding: 0; margin: 3.6rem 0 0; min-width: 0;
    display: flex; flex-direction: column; gap: 1.6rem;
  }
  .ums-intake__legend {
    font-family: var(--font-heading-family); font-weight: var(--font-heading-weight);
    font-size: 2rem; padding: 0; margin-bottom: 0.4rem; letter-spacing: -0.01em;
  }
  .ums-intake__hint { margin: -0.8rem 0 0; font-size: 1.4rem; opacity: 0.75; }

  .ums-intake__two { display: grid; gap: 1.6rem; }
  @media screen and (min-width: 750px) { .ums-intake__two { grid-template-columns: 1fr 1fr; } }

  .ums-intake .field { margin: 0; }
  .ums-intake .select__select { min-height: 4.5rem; }

  .ums-intake__checks { display: grid; gap: 0.8rem; }
  @media screen and (min-width: 750px) { .ums-intake__checks { grid-template-columns: 1fr 1fr; } }
  .ums-intake__check {
    display: flex; align-items: center; gap: 1rem; padding: 1.2rem 1.4rem;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    border-radius: var(--ums-radius, 2px); cursor: pointer; font-size: 1.5rem;
  }
  .ums-intake__check:has(input:checked) {
    border-color: var(--ums-green, #355e3b); background: var(--ums-green-050, #eef2ee);
  }
  .ums-intake__check input { width: 1.8rem; height: 1.8rem; margin: 0; accent-color: var(--ums-green, #355e3b); }
  .ums-intake__group.is-invalid .ums-intake__check { border-color: #9c4a2f; }
  .ums-intake__field-error { margin: 0; font-size: 1.4rem; font-weight: 600; color: #8a4029; }

  .ums-intake__list {
    padding: 1.6rem 1.8rem; background: var(--ums-green-050, #eef2ee);
    border-left: 3px solid var(--ums-green, #355e3b);
  }
  .ums-intake__list-head { margin: 0 0 0.8rem; font-weight: 600; font-size: 1.4rem; }
  .ums-intake__list-items { margin: 0; padding-left: 1.8rem; font-size: 1.5rem; }
  .ums-intake__list-edit { margin: 1rem 0 0; font-size: 1.3rem; }

  .ums-intake__artwork {
    padding: 1.6rem 1.8rem; border: 1px dashed rgba(var(--color-foreground), 0.3);
    border-radius: var(--ums-radius, 2px);
  }
  .ums-intake__artwork .ums-intake__hint { margin-top: 0.4rem; }

  .ums-intake__submit { margin-top: 3.6rem; display: flex; flex-direction: column; gap: 1.2rem; align-items: flex-start; }
  .ums-intake__submit .button { letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; }
  .ums-intake__submit-note { margin: 0; font-size: 1.3rem; opacity: 0.7; max-width: 50ch; }

  .ums-intake__done { max-width: 60ch; }
  .ums-intake__done:focus { outline: none; }
  .ums-intake__done-actions { margin-top: 2.8rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "UMS intake form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "UMS for Organizations" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start your order" },
    { "type": "richtext", "id": "body", "label": "Intro", "default": "<p>Tell us about your group and what you need. We'll come back to you with a quote.</p>" },
    { "type": "text", "id": "required_note", "label": "Required note", "default": "Fields marked * are required." },
    {
      "type": "textarea", "id": "product_types", "label": "Order types (checkboxes)", "info": "One per line.",
      "default": "School and work uniforms\nTeam and spirit wear\nCorporate and staff apparel\nEvent and fundraiser merch\nCustom patches\nSomething else"
    },
    {
      "type": "textarea", "id": "decoration_methods", "label": "Decoration methods", "info": "One per line.",
      "default": "Embroidery\nScreen printing\nDTF transfer\nVinyl\nNot sure yet"
    },
    {
      "type": "textarea", "id": "heard_options", "label": "How did you hear about us", "info": "One per line.",
      "default": "Walked past the shop\nInstagram\nTikTok\nGoogle\nA friend or colleague\nSomewhere else"
    },
    { "type": "text", "id": "artwork_note", "label": "Artwork note", "default": "Have a logo or design? Email it to orders@uptownmerch145.com with your organization's name and we'll match it to your request." },
    { "type": "url", "id": "build_list_url", "label": "Build your list page" },
    { "type": "text", "id": "submit_label", "label": "Submit button", "default": "Send my request" },
    { "type": "text", "id": "submit_note", "label": "Note under the button", "default": "No payment is taken here. We'll review your request and send a quote." },
    { "type": "header", "content": "After submission" },
    { "type": "text", "id": "done_heading", "label": "Confirmation heading", "default": "Thanks — we've got your request." },
    { "type": "richtext", "id": "done_body", "label": "Confirmation body", "default": "<p>Someone from the shop will look it over and get back to you by email with a quote.</p><p>If you have artwork to send, email it to orders@uptownmerch145.com with your organization's name.</p><p>Questions in the meantime? Call 646-398-8178.</p>" },
    { "type": "url", "id": "done_link", "label": "Confirmation button link" },
    { "type": "text", "id": "done_link_label", "label": "Confirmation button label", "default": "Back to the homepage" }
  ],
  "presets": [{ "name": "UMS intake form" }]
}
{% endschema %}
