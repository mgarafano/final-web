{%- comment -%}
  UMS global styles.

  Lives in the header group so it renders on every page. Shopify collects
  stylesheet-tag content into styles.css and injects it via
  content_for_header, so this loads from <head> with no flash of unstyled
  content — and it keeps every UMS customisation out of Dawn's own files,
  so a future Dawn update can't clobber it.

  Renders no visible markup.
{%- endcomment -%}

{%- comment -%}
  Organizations has no cart or checkout anywhere in its flow, so an active
  cart icon there would be misleading (brief section 3). Emitted server-side
  and conditionally, rather than as a body class, so there is no flash of a
  cart icon before JS runs.
{%- endcomment -%}
{%- if request.path contains '/pages/organizations' -%}
  <style>
    .header__icon--cart,
    #cart-icon-bubble {
      display: none !important;
    }
  </style>
{%- endif -%}

{% stylesheet %}
  /* ---------------------------------------------------------------
     Brand tokens. Palette locked per rebuild brief section 2.
     --------------------------------------------------------------- */
  :root {
    --ums-green: #355e3b;
    --ums-gray: #a9a5a4;
    --ums-gray-cool: #838388;
    --ums-white: #ffffff;
    --ums-ink: #1b1b1b;

    --ums-green-900: #24412a;
    --ums-green-050: #eef2ee;
    --ums-gray-050: #f6f5f5;
    --ums-gray-200: #e2e0df;
    --ums-gray-600: #6c6a6a;

    --ums-alert: #9c4a2f;
    --ums-alert-ink: #8a4029;
    --ums-alert-050: rgba(156, 74, 47, 0.08);

    --ums-surface: var(--ums-white);
    --ums-surface-alt: var(--ums-gray-050);
    --ums-text: var(--ums-ink);
    --ums-text-muted: var(--ums-gray-600);
    --ums-border: var(--ums-gray-200);
    --ums-accent: var(--ums-green);
    --ums-accent-hover: var(--ums-green-900);
    --ums-on-accent: var(--ums-white);

    --ums-tracking-wide: 0.06em;
    --ums-radius: 2px;

    --ums-space-2: 0.8rem;
    --ums-space-4: 1.6rem;
    --ums-space-6: 2.4rem;
    --ums-space-8: 3.2rem;
  }

  /* ---------------------------------------------------------------
     One form system for every UMS form: build your list, the intake
     form, and the contact form. Every control is the same height and
     type size, every label sits above its control at the same weight.
     Reads Dawn's input tokens so the theme editor still governs
     border and radius.
     --------------------------------------------------------------- */
  .ums-field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
  }

  .ums-label {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .ums-label__opt {
    font-weight: 400;
    opacity: 0.7;
  }

  .ums-input {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    min-height: 4.6rem;
    padding: 0 1.4rem;
    box-sizing: border-box;
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    line-height: 1.4;
    color: rgb(var(--color-foreground));
    background: rgb(var(--color-background));
    border: var(--inputs-border-width) solid rgba(var(--color-foreground), var(--inputs-border-opacity));
    border-radius: var(--inputs-radius);
  }

  .ums-input::placeholder {
    color: rgba(var(--color-foreground), 0.55);
  }

  .ums-input:focus,
  .ums-input:focus-visible {
    outline: 2px solid var(--ums-accent);
    outline-offset: 1px;
    border-color: var(--ums-accent);
  }

  textarea.ums-input {
    min-height: 12rem;
    padding: 1.2rem 1.4rem;
    line-height: 1.5;
    resize: vertical;
  }

  select.ums-input {
    padding-right: 4rem;
    cursor: pointer;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path d='M1 1l5 5 5-5' fill='none' stroke='%231b1b1b' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat;
    background-position: right 1.4rem center;
  }

  input[type="number"].ums-input {
    -moz-appearance: textfield;
  }

  input[type="file"].ums-input {
    padding: 0.9rem 1.4rem;
    min-height: 4.6rem;
    cursor: pointer;
  }

  .ums-hint {
    margin: 0;
    font-size: 1.3rem;
    line-height: 1.45;
    opacity: 0.72;
  }

  .ums-note {
    margin: 0;
    padding: 1.4rem 1.8rem;
    background: var(--ums-green-050);
    border-left: 3px solid var(--ums-accent);
    font-size: 1.5rem;
    line-height: 1.5;
  }

  .ums-note--strong {
    font-weight: 600;
  }

  .ums-alert {
    margin: 0;
    padding: 1.4rem 1.8rem;
    background: var(--ums-alert-050);
    border-left: 3px solid var(--ums-alert);
    color: var(--ums-alert-ink);
    font-size: 1.5rem;
    line-height: 1.5;
    font-weight: 600;
  }

  .ums-alert a {
    color: inherit;
  }

  .ums-form-two {
    display: grid;
    gap: 1.6rem;
  }

  @media screen and (min-width: 750px) {
    .ums-form-two { grid-template-columns: 1fr 1fr; }
  }

  .ums-cta {
    letter-spacing: var(--ums-tracking-wide);
    text-transform: uppercase;
    font-weight: 600;
  }

  .ums-cta.is-disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* ---------------------------------------------------------------
     Shared page-intro pattern for the Organizations and contact pages.
     --------------------------------------------------------------- */
  .ums-eyebrow {
    margin: 0 0 1.2rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .ums-h1 {
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .ums-lede {
    margin-top: 1.6rem;
    max-width: 60ch;
    font-size: 1.7rem;
    line-height: 1.5;
  }

  .ums-lede > :first-child { margin-top: 0; }
  .ums-lede > :last-child { margin-bottom: 0; }

  /* ---------------------------------------------------------------
     Nav weighting. "UMS for Organizations" is the primary business line
     and must read heavier than its neighbours (brief section 3), on
     mobile as well as desktop (brief section 8 / Mobile).

     Matched on href rather than a hand-added class, so the treatment
     survives the menu being reordered or renamed in Shopify admin.
     --------------------------------------------------------------- */
  .header__menu-item[href*="/pages/organizations"] {
    background: var(--ums-accent);
    color: var(--ums-on-accent);
    border-radius: var(--ums-radius);
    padding: 1rem 1.8rem;
    font-weight: 600;
    letter-spacing: var(--ums-tracking-wide);
    text-transform: uppercase;
  }

  .header__menu-item[href*="/pages/organizations"]:hover,
  .header__menu-item[href*="/pages/organizations"]:focus {
    background: var(--ums-accent-hover);
    color: var(--ums-on-accent);
  }

  .header__menu-item[href*="/pages/organizations"] span {
    text-decoration: none;
  }

  /* Mobile drawer: a filled row, not a pill. A pill inside a stacked
     text list reads as a stray button; a full-width row reads as the
     primary path, which is the signal the desktop button carries. */
  .menu-drawer__menu-item[href*="/pages/organizations"] {
    background: var(--ums-accent);
    color: var(--ums-on-accent);
    font-weight: 600;
    letter-spacing: var(--ums-tracking-wide);
    text-transform: uppercase;
  }

  .menu-drawer__menu-item[href*="/pages/organizations"]:hover,
  .menu-drawer__menu-item[href*="/pages/organizations"]:focus {
    background: var(--ums-accent-hover);
    color: var(--ums-on-accent);
  }

  /* ---------------------------------------------------------------
     Footer sits on hunter green (scheme-3). Dawn's default link
     underlines get lost against it, so soften them deliberately.
     --------------------------------------------------------------- */
  .footer__content-top .list-menu__item--link,
  .footer-block__details-content .list-menu__item--link {
    text-decoration: none;
  }

  .footer__content-top .list-menu__item--link:hover,
  .footer-block__details-content .list-menu__item--link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }
  /* ---------------------------------------------------------------
     Cart note — pickup-only messaging on the cart page and in the
     cart drawer (snippets/ums-cart-note.liquid). Replaces Dawn's
     "shipping calculated at checkout" line. Sits directly above the
     Check out button in both places.
     --------------------------------------------------------------- */
  .ums-cart-note {
    margin: 2.2rem 0 1.6rem;
    padding: 1.6rem 1.8rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.15);
    border-radius: var(--text-boxes-radius, 0);
    background: rgba(var(--color-foreground), 0.03);
    color: rgb(var(--color-foreground));
    font-size: 1.4rem;
    line-height: 1.5;
    text-align: left;
  }

  .ums-cart-note__title {
    margin: 0 0 0.4rem;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .ums-cart-note__body p {
    margin: 0;
  }

  .ums-cart-note__body p + p {
    margin-top: 0.6rem;
  }

  .ums-cart-note__tax {
    margin: 0.8rem 0 0;
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  .ums-cart-note--compact {
    margin: 1.2rem 0 0;
    padding: 1.2rem 1.4rem;
    font-size: 1.3rem;
  }

  .ums-cart-note--compact .ums-cart-note__title {
    font-size: 1.4rem;
  }

  .ums-cart-note--compact .ums-cart-note__tax {
    font-size: 1.2rem;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "UMS global styles",
  "settings": [
    {
      "type": "paragraph",
      "content": "Loads the UMS brand tokens, the shared form system, and global styling rules. Renders nothing visible — leave it in place."
    }
  ]
}
{% endschema %}
