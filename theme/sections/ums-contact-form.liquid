{%- comment -%}
  Contact form (brief §6) — native, no app.

  Name and email required, message required. Nothing else: this is a
  low-volume catch-all, not a support desk. Posts to Shopify's /contact
  like the intake form, so submissions reach the store contact address
  with each field labelled. On success the form is replaced by a
  confirmation screen. No email goes to the customer.

  Uses the shared .ums-* form system from ums-globals, so it matches the
  intake form and build-your-list tool exactly.
{%- endcomment -%}

<div class="ums-contact page-width">
  {%- form 'contact', id: 'UmsContact', class: 'ums-contact__form' -%}

    {%- if form.posted_successfully? -%}
      <div class="ums-contact__done" role="status" tabindex="-1" id="UmsContactDone">
        <h2 class="ums-h1 ums-contact__title">{{ section.settings.done_heading | escape }}</h2>
        <div class="ums-lede rte">{{ section.settings.done_body }}</div>
        <div class="ums-contact__done-actions">
          <a class="button ums-cta" href="{{ section.settings.done_link }}">{{ section.settings.done_link_label | escape }}</a>
        </div>
      </div>
      <script>
        var d = document.getElementById('UmsContactDone'); if (d) { d.focus(); window.scrollTo(0, 0); }
      </script>

    {%- else -%}

      <h2 class="ums-contact__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.body != blank -%}
        <div class="ums-lede rte">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="ums-alert ums-contact__errors" role="alert">
          <p><strong>{{ 'templates.contact.form.error_heading' | t }}</strong></p>
          <ul>
            {%- for field in form.errors -%}
              <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="ums-contact__fields">
        <div class="ums-form-two">
          <div class="ums-field">
            <label class="ums-label" for="UmsCName">Your name <span aria-hidden="true">*</span></label>
            <input class="ums-input" id="UmsCName" type="text" name="contact[Name]" required autocomplete="name">
          </div>
          <div class="ums-field">
            <label class="ums-label" for="UmsCEmail">Email <span aria-hidden="true">*</span></label>
            <input class="ums-input" id="UmsCEmail" type="email" name="contact[email]" required autocomplete="email" spellcheck="false" autocapitalize="off">
          </div>
        </div>
        <div class="ums-field">
          <label class="ums-label" for="UmsCMsg">{{ section.settings.message_label | escape }} <span aria-hidden="true">*</span></label>
          <textarea class="ums-input" id="UmsCMsg" name="contact[Message]" rows="6" required></textarea>
        </div>
      </div>

      <input type="hidden" name="contact[Source]" value="Contact form">

      <div class="ums-contact__submit">
        <button type="submit" class="button ums-cta">{{ section.settings.submit_label | escape }}</button>
        <p class="ums-hint">{{ section.settings.required_note | escape }}</p>
      </div>

    {%- endif -%}
  {%- endform -%}
</div>

{% stylesheet %}
  .ums-contact { padding-block: 1.6rem 6.4rem; max-width: 72rem; }
  .ums-contact__title { margin: 0; font-size: 2.6rem; letter-spacing: -0.01em; }
  .ums-contact__errors { margin-top: 2rem; }
  .ums-contact__errors p { margin: 0; }
  .ums-contact__errors ul { margin: 0.6rem 0 0; padding-left: 1.8rem; font-weight: 400; }
  .ums-contact__fields { display: flex; flex-direction: column; gap: 1.8rem; margin-top: 2.4rem; }
  .ums-contact__submit { margin-top: 2.8rem; display: flex; flex-direction: column; gap: 1.2rem; align-items: flex-start; }
  .ums-contact__done { max-width: 60ch; }
  .ums-contact__done:focus { outline: none; }
  .ums-contact__done-actions { margin-top: 2.8rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "UMS contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Send us a message" },
    { "type": "richtext", "id": "body", "label": "Intro", "default": "<p>For anything the shop or the group-order form doesn't cover.</p>" },
    { "type": "text", "id": "message_label", "label": "Message field label", "default": "What can we help with?" },
    { "type": "text", "id": "submit_label", "label": "Submit button", "default": "Send" },
    { "type": "text", "id": "required_note", "label": "Note under the button", "default": "Fields marked * are required. We reply by email." },
    { "type": "header", "content": "After submission" },
    { "type": "text", "id": "done_heading", "label": "Confirmation heading", "default": "Thanks — we've got your message." },
    { "type": "richtext", "id": "done_body", "label": "Confirmation body", "default": "<p>Someone from the shop will get back to you by email.</p><p>Need an answer sooner? Call 646-398-8178, Tuesday–Saturday, 11am–8pm.</p>" },
    { "type": "url", "id": "done_link", "label": "Confirmation button link" },
    { "type": "text", "id": "done_link_label", "label": "Confirmation button label", "default": "Back to the homepage" }
  ],
  "presets": [{ "name": "UMS contact form" }]
}
{% endschema %}
