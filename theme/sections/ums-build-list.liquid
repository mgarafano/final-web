{%- comment -%}
  Build your list — UMS for Organizations.

  A separate step before the intake form (brief §5.4), not embedded in it.
  Fully native: Liquid + vanilla JS, no app, no hosted component.

  The item catalog is generic goods typed into a theme setting, not Shopify
  products — the Organizations side deliberately has no product catalog and
  no cart. Nothing here shows a price at any stage.

  The 8-per-style minimum is enforced, not advertised: a line below the
  minimum blocks the customer from continuing until it is corrected.

  The finished list is handed to the intake form through sessionStorage and
  read back there to prefill the "exact products chosen" field.
{%- endcomment -%}

{%- liquid
  assign min_qty = section.settings.minimum_qty | at_least: 1
  assign items = section.settings.item_types | newline_to_br | split: '<br />'
-%}

<div class="ums-build page-width" data-min="{{ min_qty }}" data-next="{{ section.settings.next_url }}">
  <div class="ums-build__intro">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ums-build__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="ums-build__title">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.body != blank -%}
      <div class="ums-build__body rte">{{ section.settings.body }}</div>
    {%- endif -%}
    <p class="ums-build__rule">
      {{ section.settings.minimum_note | replace: '[min]', min_qty | escape }}
    </p>
  </div>

  <form class="ums-build__add" id="UmsBuildAdd" novalidate>
    <div class="ums-build__field">
      <label class="form__label" for="UmsBuildItem">{{ section.settings.item_label | escape }}</label>
      <select id="UmsBuildItem" class="select__select" required>
        <option value="">{{ section.settings.item_placeholder | escape }}</option>
        {%- for item in items -%}
          {%- assign clean = item | strip_newlines | strip -%}
          {%- if clean != blank -%}
            <option value="{{ clean | escape }}">{{ clean | escape }}</option>
          {%- endif -%}
        {%- endfor -%}
      </select>
    </div>

    <div class="ums-build__field ums-build__field--qty">
      <label class="form__label" for="UmsBuildQty">{{ section.settings.qty_label | escape }}</label>
      <input
        id="UmsBuildQty"
        class="field__input"
        type="number"
        inputmode="numeric"
        min="1"
        step="1"
        value="{{ min_qty }}"
        required
      >
    </div>

    <button type="submit" class="button button--secondary ums-build__addbtn">
      {{ section.settings.add_label | escape }}
    </button>
  </form>

  <p class="ums-build__error" id="UmsBuildError" role="alert" hidden></p>

  <div class="ums-build__list-wrap">
    <h2 class="ums-build__list-title">{{ section.settings.list_heading | escape }}</h2>

    <p class="ums-build__empty" id="UmsBuildEmpty">{{ section.settings.empty_text | escape }}</p>

    <ul class="ums-build__list" id="UmsBuildList" aria-live="polite"></ul>

    <p class="ums-build__warn" id="UmsBuildWarn" role="status" hidden></p>

    <div class="ums-build__actions">
      <a class="button ums-build__continue" id="UmsBuildContinue" href="{{ section.settings.next_url }}" aria-disabled="true">
        {{ section.settings.continue_label | escape }}
      </a>
      <button type="button" class="link ums-build__clear" id="UmsBuildClear">
        {{ section.settings.clear_label | escape }}
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('.ums-build');
    if (!root) return;

    var MIN = parseInt(root.dataset.min, 10) || 8;
    var KEY = 'ums:orgList';

    var form = document.getElementById('UmsBuildAdd');
    var itemEl = document.getElementById('UmsBuildItem');
    var qtyEl = document.getElementById('UmsBuildQty');
    var listEl = document.getElementById('UmsBuildList');
    var emptyEl = document.getElementById('UmsBuildEmpty');
    var errorEl = document.getElementById('UmsBuildError');
    var warnEl = document.getElementById('UmsBuildWarn');
    var contEl = document.getElementById('UmsBuildContinue');
    var clearEl = document.getElementById('UmsBuildClear');

    var lines = [];

    function load() {
      try {
        var raw = sessionStorage.getItem(KEY);
        if (raw) lines = JSON.parse(raw) || [];
      } catch (e) { lines = []; }
      if (!Array.isArray(lines)) lines = [];
    }

    function save() {
      try { sessionStorage.setItem(KEY, JSON.stringify(lines)); } catch (e) {}
    }

    function showError(msg) {
      errorEl.textContent = msg;
      errorEl.hidden = !msg;
    }

    function render() {
      listEl.innerHTML = '';
      emptyEl.hidden = lines.length > 0;

      lines.forEach(function (line, i) {
        var li = document.createElement('li');
        li.className = 'ums-build__row' + (line.qty < MIN ? ' is-under' : '');

        var name = document.createElement('span');
        name.className = 'ums-build__name';
        name.textContent = line.item;

        var qtyWrap = document.createElement('span');
        qtyWrap.className = 'ums-build__qtywrap';

        var label = document.createElement('label');
        label.className = 'visually-hidden';
        label.setAttribute('for', 'UmsQty' + i);
        label.textContent = 'Quantity for ' + line.item;

        var qty = document.createElement('input');
        qty.type = 'number';
        qty.min = '1';
        qty.step = '1';
        qty.id = 'UmsQty' + i;
        qty.className = 'field__input ums-build__qty';
        qty.value = line.qty;
        qty.addEventListener('change', function () {
          var v = parseInt(qty.value, 10);
          lines[i].qty = isNaN(v) || v < 1 ? 1 : v;
          save();
          render();
        });

        var remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'ums-build__remove';
        remove.textContent = 'Remove';
        remove.setAttribute('aria-label', 'Remove ' + line.item);
        remove.addEventListener('click', function () {
          lines.splice(i, 1);
          save();
          render();
        });

        qtyWrap.appendChild(label);
        qtyWrap.appendChild(qty);

        li.appendChild(name);
        li.appendChild(qtyWrap);
        li.appendChild(remove);

        if (line.qty < MIN) {
          var flag = document.createElement('span');
          flag.className = 'ums-build__flag';
          flag.textContent = 'Needs at least ' + MIN;
          li.appendChild(flag);
        }

        listEl.appendChild(li);
      });

      validate();
    }

    function validate() {
      var under = lines.filter(function (l) { return l.qty < MIN; });
      var ok = lines.length > 0 && under.length === 0;

      if (lines.length === 0) {
        warnEl.hidden = true;
      } else if (under.length > 0) {
        warnEl.hidden = false;
        warnEl.textContent =
          under.length === 1
            ? 'One line is below the ' + MIN + '-piece minimum. Raise it to continue.'
            : under.length + ' lines are below the ' + MIN + '-piece minimum. Raise them to continue.';
      } else {
        warnEl.hidden = true;
      }

      contEl.setAttribute('aria-disabled', ok ? 'false' : 'true');
      contEl.classList.toggle('is-disabled', !ok);
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      showError('');

      var item = itemEl.value;
      var qty = parseInt(qtyEl.value, 10);

      if (!item) { showError('Choose an item type first.'); itemEl.focus(); return; }
      if (isNaN(qty) || qty < 1) { showError('Enter how many you need.'); qtyEl.focus(); return; }

      var existing = lines.findIndex(function (l) { return l.item === item; });
      if (existing > -1) {
        lines[existing].qty += qty;
      } else {
        lines.push({ item: item, qty: qty });
      }

      save();
      render();
      itemEl.value = '';
      qtyEl.value = MIN;
      itemEl.focus();
    });

    clearEl.addEventListener('click', function () {
      lines = [];
      save();
      render();
    });

    contEl.addEventListener('click', function (e) {
      if (contEl.getAttribute('aria-disabled') === 'true') {
        e.preventDefault();
        if (lines.length === 0) {
          showError('Add at least one item before continuing.');
        } else {
          showError('Every line needs at least ' + MIN + ' pieces before you can continue.');
        }
      }
    });

    load();
    render();
  })();
</script>

{% stylesheet %}
  .ums-build { padding-block: 4rem 6rem; max-width: 76rem; }
  .ums-build__eyebrow {
    margin: 0 0 1.2rem; font-size: 1.2rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.7;
  }
  .ums-build__title { margin: 0; font-size: clamp(2.8rem, 5vw, 4rem); line-height: 1.08; letter-spacing: -0.02em; }
  .ums-build__body { margin-top: 1.6rem; max-width: 60ch; font-size: 1.7rem; }
  .ums-build__body > :first-child { margin-top: 0; }
  .ums-build__body > :last-child { margin-bottom: 0; }

  .ums-build__rule {
    margin: 2rem 0 0; padding: 1.2rem 1.6rem;
    background: var(--ums-green-050, #eef2ee);
    border-left: 3px solid var(--ums-green, #355e3b);
    font-weight: 600; font-size: 1.5rem;
  }

  .ums-build__add {
    display: grid; gap: 1.6rem; margin-top: 3.2rem;
    padding: 2.4rem; border: 1px solid rgba(var(--color-foreground), 0.15);
    border-radius: var(--ums-radius, 2px); align-items: end;
  }
  @media screen and (min-width: 750px) {
    .ums-build__add { grid-template-columns: 1fr 12rem auto; }
  }
  .ums-build__field { display: flex; flex-direction: column; gap: 0.6rem; }
  .ums-build__field .form__label { margin: 0; font-size: 1.4rem; font-weight: 600; }
  .ums-build__add select,
  .ums-build__add input { width: 100%; min-height: 4.5rem; padding: 0 1.2rem; }
  .ums-build__addbtn { min-height: 4.5rem; }

  .ums-build__error {
    margin: 1.6rem 0 0; padding: 1.2rem 1.6rem; font-weight: 600;
    background: rgba(200, 60, 30, 0.08); border-left: 3px solid #9c4a2f; color: #8a4029;
  }

  .ums-build__list-wrap { margin-top: 4rem; }
  .ums-build__list-title { font-size: 1.8rem; margin: 0 0 1.6rem; }
  .ums-build__empty { margin: 0; opacity: 0.7; font-style: italic; }

  .ums-build__list { list-style: none; margin: 0; padding: 0; }
  .ums-build__row {
    display: grid; grid-template-columns: 1fr auto auto; gap: 1.2rem 1.6rem;
    align-items: center; padding: 1.4rem 0;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.12);
  }
  .ums-build__row.is-under { border-left: 3px solid #9c4a2f; padding-left: 1.2rem; }
  .ums-build__name { font-weight: 600; font-size: 1.6rem; }
  .ums-build__qty { width: 8rem; min-height: 4rem; padding: 0 1rem; text-align: center; }
  .ums-build__remove {
    background: none; border: 0; cursor: pointer; padding: 0.6rem;
    font-size: 1.3rem; text-decoration: underline; text-underline-offset: 0.3rem;
    color: inherit; opacity: 0.75;
  }
  .ums-build__remove:hover { opacity: 1; }
  .ums-build__flag {
    grid-column: 1 / -1; font-size: 1.3rem; font-weight: 600; color: #8a4029;
  }

  .ums-build__warn {
    margin: 2rem 0 0; padding: 1.2rem 1.6rem; font-weight: 600;
    background: rgba(200, 60, 30, 0.08); border-left: 3px solid #9c4a2f; color: #8a4029;
  }

  .ums-build__actions {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1.6rem 2.4rem; margin-top: 3.2rem;
  }
  .ums-build__continue {
    letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600;
  }
  .ums-build__continue.is-disabled { opacity: 0.4; cursor: not-allowed; }
  .ums-build__clear {
    background: none; border: 0; cursor: pointer; font-size: 1.4rem;
    text-decoration: underline; text-underline-offset: 0.4rem; color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "UMS build your list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "UMS for Organizations" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your list" },
    { "type": "richtext", "id": "body", "label": "Intro" },
    {
      "type": "textarea",
      "id": "item_types",
      "label": "Item types",
      "info": "One per line. These are generic item types, not Shopify products.",
      "default": "T-shirts\nLong sleeve tees\nPolo shirts\nHoodies\nCrewneck sweatshirts\nQuarter-zip pullovers\nJackets\nCaps\nBeanies\nTote bags\nAprons\nCustom patches"
    },
    { "type": "number", "id": "minimum_qty", "label": "Minimum per style", "default": 8 },
    {
      "type": "text",
      "id": "minimum_note",
      "label": "Minimum notice",
      "info": "[min] is replaced with the number above.",
      "default": "Minimum order is [min] pieces per style."
    },
    { "type": "text", "id": "item_label", "label": "Item field label", "default": "Item type" },
    { "type": "text", "id": "item_placeholder", "label": "Item field placeholder", "default": "Choose an item type" },
    { "type": "text", "id": "qty_label", "label": "Quantity field label", "default": "How many" },
    { "type": "text", "id": "add_label", "label": "Add button", "default": "Add to list" },
    { "type": "text", "id": "list_heading", "label": "List heading", "default": "Your list" },
    { "type": "text", "id": "empty_text", "label": "Empty list text", "default": "Nothing added yet. Choose an item type above to start." },
    { "type": "text", "id": "continue_label", "label": "Continue button", "default": "Continue to the order form" },
    { "type": "text", "id": "clear_label", "label": "Clear button", "default": "Clear the list" },
    { "type": "url", "id": "next_url", "label": "Order form page" }
  ],
  "presets": [{ "name": "UMS build your list" }]
}
{% endschema %}
